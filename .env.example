# ──────────────────────────────────────────────────────
# DevFlow Frontend — Environment Variables (template)
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or files containing secrets.
# ──────────────────────────────────────────────────────

# Public site URL used for absolute links, OpenGraph, sitemaps.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI backend base URL (server-side + client-side).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL for real-time features.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Enable verbose client-side logging in development.
NEXT_PUBLIC_ENABLE_DEBUG=false
